# ShellCheck 配置（全量严格模式）
# 文档：https://github.com/koalaman/shellcheck/wiki/Directive
# 用法：
#   shellcheck --rcfile .lintrc/infrastructure/shell/.shellcheckrc <script.sh>
#   # CI 建议：将本文件复制到仓库根目录，ShellCheck 会自动发现
#
# 涵盖的嵌入式/构建脚本场景：
#   init-RK3588.sh、apply-patches.sh、clean-patches.sh、
#   rkbin/tools/*.sh、u-boot/make.sh 等

# ------------------------------------------------------------------
# Shell 方言
# ------------------------------------------------------------------
# 对无 shebang 的脚本使用 bash 方言（项目内所有脚本均使用 bash）
# 有 shebang 的脚本会自动覆盖此设置
shell=bash

# ------------------------------------------------------------------
# 数据流分析
# ------------------------------------------------------------------
# 显式启用扩展数据流分析，检出更多隐式错误
# （对于 2000+ 行的自动生成脚本可在文件内用注释局部关闭）
extended-analysis=true

# ------------------------------------------------------------------
# Source 文件解析
# ------------------------------------------------------------------
# 允许跟踪所有 source / . 语句指向的文件（不限于命令行指定的文件）
# 对 init-RK3588.sh 等会 source 其他片段的脚本至关重要
external-sources=true

# 在脚本自身所在目录查找被 source 的文件
source-path=SCRIPTDIR

# ------------------------------------------------------------------
# 可选检查（全部启用）
# ------------------------------------------------------------------
# `enable=all` 等价于逐条启用以下所有可选检查（v0.11.0）：
#
#   add-default-case          — case 语句缺少 *) 默认分支时提示
#   avoid-negated-conditions  — 建议将 [ ! "$x" -eq 1 ] 改为 [ "$x" -ne 1 ]
#   avoid-nullary-conditions  — 建议将 [ "$var" ] 改为 [ -n "$var" ]
#   check-extra-masked-returns — 检查额外的返回值被掩盖的情况
#   check-set-e-suppressed    — set -e 因函数调用被抑制时提示
#   check-unassigned-uppercase — 使用未赋值的大写变量时警告
#   deprecate-which           — 建议用 command -v 替代 which
#   quote-safe-variables      — 对无元字符的变量也建议加引号
#   require-double-brackets   — bash/ksh 中要求用 [[ ]] 而非 [ ]
#   require-variable-braces   — 建议所有变量引用加花括号 ${var}
#   useless-use-of-cat        — 检测 cat file | cmd 类型的 UUOC
enable=all

