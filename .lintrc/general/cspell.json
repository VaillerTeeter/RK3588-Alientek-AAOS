{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",

  "words": [],

  "flagWords": [
    "hte",
    "teh",
    "recieve",
    "occured",
    "doesnt",
    "cant",
    "dont",
    "couldnt",
    "shouldnt",
    "wont",
    "wouldnt",
    "isnt",
    "wasnt",
    "werent",
    "arent",
    "havent",
    "hasnt",
    "hadnt",
    "neednt"
  ],

  "dictionaries": [
    "en_US",
    "companies",
    "softwareTerms",
    "misc",
    "filetypes",
    "cpp",
    "python",
    "bash",
    "git",
    "markdown"
  ],

  "ignorePaths": [
    ".git",
    ".git/**",
    "**/.git",
    "**/.git/**",
    "Android/rk-kernel-5.10/**",
    "Android/u-boot/**",
    "Android/rkbin/**",
    "Android/prebuilts/**",
    "out/**",
    "LICENSE"
  ],

  "overrides": [
    {
      "filename": "**/*.{yaml,yml}",
      "words": []
    },
    {
      "filename": "**/*.{md,mdx,rst}",
      "words": []
    },
    {
      "filename": "**/README.md",
      "flagWords": []
    }
  ],

  "enableGlobDot": true,
  "useGitignore": true,
  "maxNumberOfProblems": 50,
  "minWordLength": 4
}
