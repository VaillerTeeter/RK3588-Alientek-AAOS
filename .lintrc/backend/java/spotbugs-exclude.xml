<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 排除过滤器 — 最严格模式（无任何排除项）
  语法参考：https://spotbugs.readthedocs.io/en/stable/filter.html

  此文件保持为空（无任何 Match 条目）。
  SpotBugs 将对所有代码强制执行完整规则集，不排除任何检测项。

  如在特定场景（如测试代码、框架生成代码）中确实存在误报，
  应在代码级别通过 @SuppressWarnings 并附上原因注释处理，
  而非在此全局豁免，以保证审查记录可追溯。
-->
<FindBugsFilter
  xmlns="https://github.com/spotbugs/filter/3.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
                    https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

