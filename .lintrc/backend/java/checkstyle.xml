<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle 配置 — 基于 Google Java Style Guide 定制
  参考：https://checkstyle.org/google_style.html
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- ── 文件级检查 ──────────────────────────────────── -->

  <!-- 文件末尾必须有换行符 -->
  <module name="NewlineAtEndOfFile"/>

  <!-- 文件长度上限：800 行 -->
  <module name="FileLength">
    <property name="max" value="800"/>
  </module>

  <!-- 禁止制表符（Tab） -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <!-- 行尾不能有多余空格 -->
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="行尾不允许有多余空格"/>
  </module>

  <!-- 行长度：最多 100 字符（文件级检查，必须在 Checker 下） -->
  <module name="LineLength">
    <property name="max" value="100"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
  </module>

  <!-- ── 树遍历检查（Token-based） ──────────────────── -->
  <module name="TreeWalker">

    <!-- ===== 命名规范 ===== -->

    <!-- 包名：全小写，可含点和数字 -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- 类名 / 接口名：PascalCase -->
    <module name="TypeName"/>

    <!-- 方法名：lowerCamelCase -->
    <module name="MethodName"/>

    <!-- 局部变量名：lowerCamelCase，允许单字符（i/j/k/e/x/y/z） -->
    <module name="LocalVariableName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
    </module>

    <!-- 局部 final 变量（try-with-resources 等）：lowerCamelCase -->
    <module name="LocalFinalVariableName"/>

    <!-- 成员变量：lowerCamelCase -->
    <module name="MemberName"/>

    <!-- static 成员变量：lowerCamelCase（非常量） -->
    <module name="StaticVariableName"/>

    <!-- 常量（static final）：UPPER_CASE -->
    <module name="ConstantName"/>

    <!-- 参数名：lowerCamelCase -->
    <module name="ParameterName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
    </module>

    <!-- 泛型类型参数：单个大写字母，或大写字母后跟数字 -->
    <module name="ClassTypeParameterName">
      <property name="format" value="^[A-Z][0-9]?$"/>
    </module>
    <module name="MethodTypeParameterName">
      <property name="format" value="^[A-Z][0-9]?$"/>
    </module>

    <!-- catch 块参数：lowerCamelCase 或单字符 e -->
    <module name="CatchParameterName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
    </module>

    <!-- ===== Javadoc ===== -->

    <!-- public 类必须有 Javadoc -->
    <module name="JavadocType">
      <property name="scope" value="public"/>
    </module>

    <!-- public / protected 方法必须有 Javadoc -->
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public, protected"/>
      <property name="allowMissingParamTags" value="false"/>
      <property name="allowMissingReturnTag" value="false"/>
    </module>

    <!-- public / protected 变量必须有 Javadoc -->
    <module name="JavadocVariable">
      <property name="scope" value="protected"/>
    </module>

    <!-- Javadoc 样式：摘要句必须以句点结尾 -->
    <module name="JavadocStyle">
      <property name="checkFirstSentence" value="true"/>
      <property name="endOfSentenceFormat" value="([.?!][ \t\n\r\f&lt;])|([.?!]$)"/>
    </module>

    <!-- ===== Import ===== -->

    <!-- 禁止通配符 import -->
    <module name="AvoidStarImport"/>

    <!-- 禁止冗余 import（重复或 java.lang） -->
    <module name="RedundantImport"/>

    <!-- 禁止未使用的 import -->
    <module name="UnusedImports"/>

    <!-- import 顺序：static import 在最后，各组之间空行 -->
    <module name="ImportOrder">
      <property name="groups" value="java,javax,org,com"/>
      <property name="ordered" value="true"/>
      <property name="separated" value="true"/>
      <property name="option" value="bottom"/>
      <property name="sortStaticImportsAlphabetically" value="true"/>
    </module>

    <!-- ===== 代码尺寸 ===== -->

    <!-- 方法长度：最多 60 行（不含空行和注释） -->
    <module name="MethodLength">
      <property name="max" value="60"/>
      <property name="countEmpty" value="false"/>
    </module>

    <!-- 方法参数数：最多 5 个 -->
    <module name="ParameterNumber">
      <property name="max" value="5"/>
    </module>

    <!-- 匿名类长度：最多 20 行 -->
    <module name="AnonInnerLength">
      <property name="max" value="20"/>
    </module>

    <!-- ===== 大括号与空白 ===== -->

    <!-- 左大括号位置：行尾（K&R/Allman 之外的 Otbs 风格） -->
    <module name="LeftCurly"/>

    <!-- 右大括号位置 -->
    <module name="RightCurly"/>

    <!-- if / else / for / while / do 必须用大括号 -->
    <module name="NeedBraces"/>

    <!-- 空块必须包含注释（如 catch(Exception e) {}） -->
    <module name="EmptyBlock">
      <property name="option" value="text"/>
    </module>

    <!-- 操作符换行：换行在操作符前 -->
    <module name="OperatorWrap"/>

    <!-- 方法调用的点号换行：点号在下一行开头 -->
    <module name="SeparatorWrap">
      <property name="id" value="SeparatorWrapDot"/>
      <property name="tokens" value="DOT"/>
      <property name="option" value="nl"/>
    </module>

    <!-- 逗号换行：逗号在末尾 -->
    <module name="SeparatorWrap">
      <property name="id" value="SeparatorWrapComma"/>
      <property name="tokens" value="COMMA"/>
      <property name="option" value="EOL"/>
    </module>

    <!-- 空格检查 -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyLambdas" value="true"/>
      <property name="allowEmptyMethods" value="true"/>
      <property name="allowEmptyTypes" value="true"/>
      <property name="allowEmptyLoops" value="true"/>
    </module>
    <module name="WhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>
    <module name="NoWhitespaceAfter"/>
    <module name="GenericWhitespace"/>
    <module name="MethodParamPad"/>
    <module name="ParenPad"/>
    <module name="TypecastParenPad"/>

    <!-- 缩进：4 空格，续行 8 空格 -->
    <module name="Indentation">
      <property name="basicOffset" value="4"/>
      <property name="braceAdjustment" value="0"/>
      <property name="caseIndent" value="4"/>
      <property name="throwsIndent" value="8"/>
      <property name="lineWrappingIndentation" value="8"/>
      <property name="arrayInitIndent" value="4"/>
    </module>

    <!-- ===== 编码规范 ===== -->

    <!-- 修饰符顺序：public protected private abstract default static ... -->
    <module name="ModifierOrder"/>

    <!-- 多余修饰符（如接口中的 public abstract） -->
    <module name="RedundantModifier"/>

    <!-- switch 必须有 default 分支 -->
    <module name="DefaultComesLast"/>
    <module name="MissingSwitchDefault"/>

    <!-- switch case 之间不允许直通（fall-through），需加 // fall through 注释 -->
    <module name="FallThrough"/>

    <!-- long 字面量使用 L 而非 l -->
    <module name="UpperEll"/>

    <!-- 数组声明风格：int[] arr 而非 int arr[] -->
    <module name="ArrayTypeStyle"/>

    <!-- 不允许使用 == 比较字符串 -->
    <module name="StringLiteralEquality"/>

    <!-- 不允许多次赋值：a = b = c -->
    <module name="MultipleVariableDeclarations"/>

    <!-- 每行只有一条语句 -->
    <module name="OneStatementPerLine"/>

    <!-- 不允许空语句（孤立的分号） -->
    <module name="EmptyStatement"/>

    <!-- 不允许在 equals() 中使用 == -->
    <module name="CovariantEquals"/>

    <!-- 重写 equals() 必须同时重写 hashCode() -->
    <module name="EqualsHashCode"/>

    <!-- clone() 必须调用 super.clone() -->
    <module name="SuperClone"/>

    <!-- finalize() 必须调用 super.finalize() -->
    <module name="SuperFinalize"/>

    <!-- 禁止内联条件（三元运算符）— 强制使用完整 if/else 以提升可读性 -->
    <module name="AvoidInlineConditionals"/>

    <!-- 禁止魔法数字（仅 0, 1 除外；所有其他数值必须定义为命名常量）-->
    <module name="MagicNumber">
      <property name="ignoreNumbers" value="0, 1"/>
      <property name="ignoreAnnotation" value="false"/>
      <property name="ignoreHashCodeMethod" value="false"/>
      <property name="ignoreFieldDeclaration" value="false"/>
    </module>

    <!-- 简化布尔表达式：禁止 b == true、b != false 等 -->
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- 禁止不必要的括号 -->
    <module name="UnnecessaryParentheses"/>

    <!-- 禁止使用过时的 API -->
    <module name="IllegalType">
      <property name="illegalClassNames" value="
        java.util.Hashtable,
        java.util.Vector,
        java.util.Stack,
        java.util.StringTokenizer,
        java.util.Date,
        java.sql.Date,
        java.util.Calendar"/>
    </module>

    <!-- ===== 设计 ===== -->

    <!-- 工具类（所有成员均为 static）必须有私有构造器 -->
    <module name="HideUtilityClassConstructor"/>

    <!-- 接口不应只用于定义常量（Constant Interface 反模式） -->
    <module name="InterfaceIsType"/>

    <!-- 类的外联耗类数量：单类引用别类不超过 20 个 -->
    <module name="ClassFanOutComplexity">
      <property name="max" value="20"/>
    </module>

    <!-- 方法声明 throws 的异常类不超过 3 个 -->
    <module name="ThrowsCount">
      <property name="max" value="3"/>
      <property name="ignorePrivateMethods" value="false"/>
    </module>

    <!-- 布尔表达式复杂度：&&/|| 操作符不超过 3 个 -->
    <module name="BooleanExpressionComplexity">
      <property name="max" value="3"/>
    </module>

    <!-- 圈复杂度上限：10（与 PMD/detekt 对齐） -->
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>

    <!-- 可见性控制：所有成员变量必须为 private（不允许 protected 字段） -->
    <module name="VisibilityModifier">
      <property name="packageAllowed" value="false"/>
      <property name="protectedAllowed" value="false"/>
    </module>

    <!-- ===== 杂项 ===== -->

    <!-- TODO 注释格式化（允许但统一格式） -->
    <module name="TodoComment">
      <property name="format" value="(TODO|FIXME|HACK|XXX):"/>
    </module>

    <!-- 禁止在代码中出现 System.out.println -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="System\.out\.print"/>
      <property name="message" value="不允许使用 System.out.print，请使用日志框架"/>
      <property name="ignoreComments" value="true"/>
    </module>

    <!-- 禁止 printStackTrace() -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="\.printStackTrace\(\)"/>
      <property name="message" value="不允许使用 printStackTrace()，请使用日志框架"/>
      <property name="ignoreComments" value="true"/>
    </module>

    <!-- ===== 文件结构 ===== -->

    <!-- 每个 Java 文件只允许有一个顶层类/接口/枚举 -->
    <module name="OneTopLevelClass"/>

    <!-- 文件名必须与顶层类名完全一致（大小写敏感）-->
    <module name="OuterTypeFilename"/>

    <!-- 内部类 / 内部接口 / 内部枚举声明必须在所有成员之后 -->
    <module name="InnerTypeLast"/>

    <!-- ===== 注解 ===== -->

    <!-- 注解必须独占一行，不允许与被注解元素同行 -->
    <module name="AnnotationLocation">
      <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
    </module>

    <!-- 注解使用风格一致：紧凑无数组风格，无多余括号 -->
    <module name="AnnotationUseStyle">
      <property name="elementStyle" value="compact_no_array"/>
      <property name="closingParens" value="never"/>
      <property name="trailingArrayComma" value="never"/>
    </module>

    <!-- 禁止使用 @SuppressWarnings("all")，只允许具体的检查名称 -->
    <module name="SuppressWarnings">
      <property name="format" value="^all$"/>
    </module>

    <!-- ===== Javadoc 增强 ===== -->

    <!-- @param / @return / @throws / @deprecated 顺序强制固定 -->
    <module name="AtclauseOrder">
      <property name="tagOrder" value="@param, @return, @throws, @deprecated"/>
    </module>

    <!-- Javadoc 标签位置必须正确（@param 等不能出现在描述文字之间）-->
    <module name="JavadocBlockTagLocation"/>

    <!-- @param @return @throws 等标签必须有非空描述文字 -->
    <module name="NonEmptyAtclauseDescription"/>

    <!-- 摘要第一句不允许以废话片段开头，并须以句点结束 -->
    <module name="SummaryJavadoc">
      <property name="forbiddenSummaryFragments"
                value="^@return the *|^This method returns |^A [{]@code [a-zA-Z0-9]+[}]( is a )"/>
      <property name="period" value="."/>
    </module>

    <!-- 单行 Javadoc 中不应包含块标签 -->
    <module name="SingleLineJavadoc">
      <property name="ignoreInlineTags" value="false"/>
    </module>

    <!-- ===== 异常处理（最严格）===== -->

    <!-- 禁止 catch 过宽的异常类型（必须捕获具体异常类）-->
    <module name="IllegalCatch">
      <property name="illegalClassNames"
                value="Exception, RuntimeException, Error, Throwable,
                       NullPointerException, ArrayIndexOutOfBoundsException,
                       IndexOutOfBoundsException, ClassCastException"/>
    </module>

    <!-- 禁止 throws 声明过宽的异常类型 -->
    <module name="IllegalThrows">
      <property name="illegalClassNames"
                value="Error, RuntimeException, Throwable, Exception,
                       NullPointerException"/>
    </module>

    <!-- 禁止 finalize() 方法（Java 9+ 已废弃，存在安全隐患）-->
    <module name="NoFinalizer"/>

    <!-- ===== 复杂度（补充）===== -->

    <!-- NPath 复杂度上限：100（与圈复杂度互补，衡量可执行路径数）-->
    <module name="NPathComplexity">
      <property name="max" value="100"/>
    </module>

    <!-- 非注释源码行数（NCSS）：方法≤60，类≤400，文件≤800 -->
    <module name="JavaNCSS">
      <property name="methodMaximum" value="60"/>
      <property name="classMaximum" value="400"/>
      <property name="fileMaximum" value="800"/>
    </module>

    <!-- 类数据抽象耦合（实例化的不同外部类型数量）：上限 10 -->
    <module name="ClassDataAbstractionCoupling">
      <property name="max" value="10"/>
    </module>

    <!-- ===== 方法约束 ===== -->

    <!-- 单类方法数上限（含各可见性独立限制）-->
    <module name="MethodCount">
      <property name="maxTotal" value="15"/>
      <property name="maxPrivate" value="10"/>
      <property name="maxPackage" value="5"/>
      <property name="maxProtected" value="5"/>
      <property name="maxPublic" value="12"/>
    </module>

    <!-- 每个方法最多 3 个 return 语句（void 方法最多 1 个）-->
    <module name="ReturnCount">
      <property name="max" value="3"/>
      <property name="maxForVoid" value="1"/>
    </module>

    <!-- ===== 变量约束 ===== -->

    <!-- 能声明为 final 的局部变量必须声明为 final（含增强 for 循环变量）-->
    <module name="FinalLocalVariable">
      <property name="validateEnhancedForLoopVariable" value="true"/>
    </module>

    <!-- 禁止局部变量或参数遮蔽（shadow）成员字段 -->
    <module name="HiddenField">
      <property name="ignoreConstructorParameter" value="false"/>
      <property name="ignoreSetter" value="false"/>
      <property name="ignoreAbstractMethods" value="false"/>
    </module>

    <!-- 变量声明与首次使用之间允许距离≤3 行 -->
    <module name="VariableDeclarationUsageDistance">
      <property name="allowedDistance" value="3"/>
      <property name="ignoreFinal" value="false"/>
    </module>

    <!-- ===== 代码结构 ===== -->

    <!-- 类内声明顺序：static 变量 → 实例变量 → 构造器 → 方法 -->
    <module name="DeclarationOrder"/>

    <!-- 重载方法必须连续声明，不允许穿插其他方法 -->
    <module name="OverloadMethodsDeclarationOrder"/>

    <!-- ===== 字符串 ===== -->

    <!-- 相同字符串字面量不允许出现超过 1 次（必须提取为常量）-->
    <module name="MultipleStringLiterals">
      <property name="allowedDuplicates" value="1"/>
    </module>

    <!-- ===== 格式 ===== -->

    <!-- 类成员（字段、方法、构造器等）之间必须有空行 -->
    <module name="EmptyLineSeparator">
      <property name="allowNoEmptyLineBetweenFields" value="false"/>
      <property name="allowMultipleEmptyLines" value="false"/>
      <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
    </module>

    <!-- 注释缩进必须与跟随的代码缩进一致 -->
    <module name="CommentsIndentation"/>

    <!-- 禁止行尾拖尾注释（// ...），注释应置于代码行上方 -->
    <module name="TrailingComment"/>

    <!-- ===== 嵌套深度 ===== -->

    <!-- if 语句嵌套不超过 3 层 -->
    <module name="NestedIfDepth">
      <property name="max" value="3"/>
    </module>

    <!-- try 块嵌套不超过 2 层 -->
    <module name="NestedTryDepth">
      <property name="max" value="2"/>
    </module>

    <!-- ===== 入口点控制 ===== -->

    <!-- 禁止在非入口类中出现 public static void main(String[]) 方法 -->
    <module name="UncommentedMain">
      <property name="excludedClasses" value="^Main$|^Application$|^App$|^Launcher$"/>
    </module>

  </module>
</module>
