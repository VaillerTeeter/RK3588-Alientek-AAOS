+int drawLine(int x1, int y1, int x2, int y2) {
+    int x,y;
+    if (x1 == x2) {
+        x = x1;
+        for (y = MIN(y1, y2); y <= MAX(y1, y2); y++) {
+            drawPoint(x, y);
+        }
+    } else if (y1 == y2) {
+        y = y1;
+        for (x = MIN(x1, x2); x <= MAX(x1, x2); x++) {
+            drawPoint(x, y);
+        }
+    } else if (ABS(x1-x2) > ABS(y1-y2)) {
+        for (x = MIN(x1, x2); x <= MAX(x1, x2); x++) {
+            y = ((y2 - y1) * (x - x1)) / (x2 - x1) + y1;
+            drawPoint(x, y);
+        }
+    } else {
+        for (y = MIN(y1, y2); y <= MAX(y1, y2); y++) {
+            x = ((x2 - x1) * (y - y1)) / (y2 - y1) + x1;
+            drawPoint(x, y);
+        }
+    }
+    return 0;
