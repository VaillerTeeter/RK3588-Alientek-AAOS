+        mOrientation = 0;
+        mRawOrientation = 0;
+        mLastUIRotatedRawOrientation = 0;
+        mLastOrientation = OrientationEventListener.ORIENTATION_UNKNOWN;
+        mUIRotated = 0;
+        mScreenOrientation = ActivityInfo.SCREEN_ORIENTATION_PORTRAIT;
+        mIsPortrait = true;
+    }
