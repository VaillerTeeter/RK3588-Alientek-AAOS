+    private void stop(boolean remove_status_icon) {
+        if (mPlayer != null && mPlayer.isInitialized()) {
+            mPlayer.stop();
+        }
+        mFileToPlay = null;
+        if (mCursor != null) {
+            mCursor.close();
+            mCursor = null;
