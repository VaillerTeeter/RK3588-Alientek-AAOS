+            return true;
+        }
+        //-----------------------rk code----------
+        else if (0 == strncmp("rk_handwrite_win", otherHandle->getName().c_str(), 16)) {
+            return true;
+        }
+        //----------------------------------------
+    }
+    return false;
+}
